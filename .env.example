# Where the tools are, when they are not in the PATH or in the usual places (see DEVELOPERS.md)
# OPENSIM_API=/path/to/opensim-engine/bin/opensim-api

# APT sources used by quick-install.sh. Replace APT_SOURCE for a personal repo;
# APT_SOURCE_TESTS adds a second source without changing the primary one.
APT_SOURCE="deb [signed-by=/usr/share/keyrings/magiiic-packaging.gpg] https://apt.magiiic.com charm stable"
APT_SOURCE_TESTS=
# APT_SOURCE_DIR=/path/to/local/deb-packages
