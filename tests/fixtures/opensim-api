#!/usr/bin/env bash
# A stand-in for opensim-api: answers POST /setups/quick as the engine does (the questions that are wrong, the setup, the types and the
# options), for the tests.
body=$(cat)
jq -n --argjson body "$body" '
    $body.data.attributes as $a
    | ($a.type // "grid") as $type
    | ($a.avatar // "" | gsub("é"; "e") | gsub("í"; "i") | gsub("ç"; "c")) as $avatar
    | ($a.name // "Amy") as $name
    | (($a.hypergrid // "yes") != "no") as $hypergrid
    | ((if $avatar != ($a.avatar // "") then {avatar: "transliterated"} elif ($a.avatar // "") | test("^\\S+ \\S+$") then {} else {avatar: "invalid (First Last)"} end)
        + (if ($a.password // "") == "" then {password: "required"} else {} end)
        + (if ($a.ossl // "no") == "maybe" then {ossl: "invalid"} else {} end)) as $problems
    | def yn($key; $default): (if ($a[$key] // $default) == "yes" then "yes" else "no" end);
    {data: {type: "setups", id: "quick", attributes: {
        valid: ($problems | length == 0),
        problems: $problems,
        corrected: (if $avatar != ($a.avatar // "") then {avatar: $avatar} else {} end),
        types: [
            {name: "grid", label: "Grid", implemented: true},
            {name: "standalone", label: "Standalone", implemented: true},
            {name: "simulator", label: "Simulator (join other grid)", implemented: false},
            {name: "speculoos", label: "Speculoos", implemented: false}
        ],
        options: [
            {name: "ssl", label: "SSL", default: false, value: (yn("ssl"; "no") == "yes"), implemented: false},
            {name: "hypergrid", label: "Hypergrid", default: true, value: $hypergrid, implemented: true},
            {name: "search", label: "Cross-grid Search", default: false, value: (yn("search"; "no") == "yes"), implemented: false},
            {name: "gloebit", label: "Economy: Gloebit", default: false, value: (yn("gloebit"; "no") == "yes"), implemented: false},
            {name: "ossl", label: "Extended OSSL", default: false, value: (yn("ossl"; "no") == "yes"), implemented: false}
        ],
        setup: {
            grid: {
                name: $name, nick: ($name | ascii_downcase | gsub(" "; "_")), hostname: "amy.example.org", public_port: 8002,
                hypergrid: $hypergrid, database: {name: "amy_robust", user: "opensim"}
            },
            simulators: [{name: (if $type == "standalone" then $name else "Welcome" end),
                database: {name: "amy_welcome", user: "opensim"}, regions: [{name: "Welcome"}]}],
            owner: {name: ($a.avatar // "")}
        },
        rows: [
            {section: "grid", label: "Grid name", value: ($name + " (" + ($name | ascii_downcase | gsub(" "; "_")) + ")")},
            {section: "grid", label: "Login URI", value: "http://amy.example.org:8002"},
            {section: "options", label: "Hypergrid", value: (if $hypergrid then "yes" else "no" end)},
            {section: "options", label: "SSL", value: (yn("ssl"; "no") + " (not implemented)")},
            {section: "simulator", label: "Simulator", value: (if $type == "standalone" then $name else "Welcome" end)},
            {section: "owner", label: "Avatar", value: ($a.avatar // "")}
        ]
    }}}'
