#!/usr/bin/env bash
# Run inside the clean machine by tests/Packaging/check.
# Tests that the opensim-cli package installs correctly and the CLI works.

set -eo pipefail
status=0
check() { if eval "$2"; then echo "   ok: $1"; else echo "   FAILED: $1"; status=1; fi; }

export DEBIAN_FRONTEND=noninteractive

# Install the package
apt-get update -qq >/dev/null
apt-get install -y -qq /tmp/debs/*.deb >/tmp/apt.log 2>&1 || {
    echo "--- apt.log tail ---"
    tail -20 /tmp/apt.log
    echo "--- end ---"
    exit 1
}

# Test 1: Package is installed
check "opensim-cli package is installed" "dpkg -s opensim-cli >/dev/null 2>&1"

# Test 2: quick-install.sh exists
check "quick-install.sh exists" "[ -x /usr/share/opensim-cli/quick-install.sh ]"

# Test 3: opensim command exists and is executable
check "opensim command exists" "[ -x /usr/bin/opensim ]"

# Test 4: opensim --help works
check "opensim --help works" "opensim --help | grep -q usage"

# Test 5: opensim status runs (may show no instances, that's fine)
check "opensim status runs" "opensim status >/dev/null 2>&1 || true"

# Test 6: Try opensim setup (may fail currently, we just check it starts)
# We just check the command exists and is executable, not its success
ANSWERS=$'1\n'
output=$(echo "$ANSWERS" | FE_INPUT_FD=0 FE_TTY=/dev/null OPENSIM_SETUP_UI=plain opensim setup 2>&1 || true)
check "opensim setup starts" "[ -n \"$output\" ]"

exit $status
