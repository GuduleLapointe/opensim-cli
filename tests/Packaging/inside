#!/usr/bin/env bash
# Run inside the clean machine by tests/Packaging/check.
# Tests that the opensim-cli package installs correctly and the CLI works.

set -eo pipefail
status=0
check() { if eval "$2"; then echo "   ok: $1"; else echo "   FAILED: $1"; status=1; fi; }
installation_ready=true
check_installation() {
    if eval "$2"; then
        echo "   ok: $1"
    else
        echo "   FAILED: $1"
        status=1
        installation_ready=false
    fi
}

export DEBIAN_FRONTEND=noninteractive

# Install the package
apt-get update -qq >/dev/null
apt-get install -y -qq /tmp/debs/*.deb >/tmp/apt.log 2>&1 || {
    echo "--- apt.log tail ---"
    tail -20 /tmp/apt.log
    echo "--- end ---"
    exit 1
}

# Installation prerequisites are separate checks; application tests depend on
# all three succeeding.
check_installation "opensim-cli package is installed" "dpkg -s opensim-cli >/dev/null 2>&1"
check_installation "quick-install.sh exists" "[ -x /usr/share/opensim-cli/quick-install.sh ]"
check_installation "opensim executable is installed" "[ -x /usr/bin/opensim ]"
check_installation "opensim command exists" "command -v opensim >/dev/null 2>&1"

if [[ "$installation_ready" != true ]]; then
    echo "   SKIPPED: opensim --help (installation prerequisites failed)"
    echo "   SKIPPED: opensim status (installation prerequisites failed)"
    echo "   SKIPPED: opensim setup (installation prerequisites failed)"
    exit "$status"
fi

# Application tests run only after the package and `opensim` command are ready.
check "opensim --help works" "opensim --help | grep -q usage"

# Test: opensim status runs (may show no instances, that's fine)
check "opensim status runs" "opensim status >/dev/null 2>&1 || true"

# Try opensim setup - on a fresh container without sudo, this will fail
# Capture both stdout and stderr
ANSWERS=$'1\n'
output=$(echo "$ANSWERS" | FE_INPUT_FD=0 FE_TTY=/dev/null OPENSIM_SETUP_UI=plain opensim setup 2>&1 || true)
check "opensim setup runs" "[ -n \"$output\" ] || echo 'Setup produced no output' >&2"

exit $status
