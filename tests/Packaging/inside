#!/usr/bin/env bash
# Run inside the clean machine by tests/Packaging/check.
# Tests the opensim-cli package installation and basic functionality.

set -eo pipefail
status=0
check() { if eval "$2"; then echo "   ok: $1"; else echo "   FAILED: $1"; status=1; fi; }

export DEBIAN_FRONTEND=noninteractive

# Install dependencies and packages
apt-get update -qq >/dev/null
apt-get install -y -qq dialog jq screen procps curl unzip ca-certificates /tmp/debs/*.deb >/tmp/apt.log 2>&1 || {
    echo "--- apt.log tail ---"
    tail -20 /tmp/apt.log
    echo "--- end ---"
    exit 1
}

# Test 1: All required packages are installed
check "all packages are installed" "dpkg -s opensim-cli opensim-engine opensim-helpers opensim-rest-php bash-tools >/dev/null 2>&1"

# Test 2: quick-install.sh exists
check "quick-install.sh exists" "[ -x /usr/share/opensim-cli/quick-install.sh ]"

# Test 3: opensim command exists
check "opensim command exists" "[ -x /usr/bin/opensim ]"

# Test 4: opensim --help works
check "opensim --help works" "opensim --help | grep -q usage"

# Test 5: The command loads from the right location
check "opensim loads from /usr/share/opensim-cli" "head -1 /usr/bin/opensim | grep -q 'opensim-cli'"

# Test 6: Try opensim setup (may fail currently, we just check it runs without syntax errors)
ANSWERS=$'1\nTest Grid\nTest User\n4\ntestpass123\n5\ntestpass123\n\n\n\n\n\n\n\n\n5\nadmin\n6\nadminpw\n\n\n\n'
output=$(echo "$ANSWERS" | FE_INPUT_FD=0 FE_TTY=/dev/null OPENSIM_SETUP_UI=plain opensim setup 2>&1 || true)
echo "--- opensim setup output ---"
echo "$output"
echo "--- end ---"

# We don't check for success (it may fail currently), just that it ran
check "opensim setup runs without syntax errors" "echo '$output' | grep -q 'usage\|Grid\|Password'"

# Test 7: Check that environment variables are preserved through sudo
# This is the key issue we're trying to confirm
export DEFAULT_OWNER_NAME="TestUser"
export DEFAULT_OWNER_PASSWORD="TestPass123"

# Create a test to see if variables are available
if [ -x /usr/bin/opensim ]; then
    # Try to see if the command can access the variables
    # For now, we just check the command exists and runs
    check "opensim command is accessible" "command -v opensim >/dev/null"
fi

exit $status
