# Environment of the tests: copy this file as tests/.env (git-ignored) and edit it. It is read after the .env of the project.

# Run the container checks on the podman of another machine (a podman system connection)
# CONTAINER_CONNECTION=

# Memory of the container (default 400m)
# MEMORY=400m

# Container engine for tests/Compatibility (default: auto, prefers Podman)
# COMPAT_ENGINE=podman

# Optional alternate compatibility platform matrix (default: tests/Compatibility/platforms.tsv)
# COMPAT_PLATFORMS_FILE=/path/to/platforms.tsv

# Keep compatibility containers running after their tests for Podman Desktop inspection (default: remove them)
# COMPAT_KEEP=1
