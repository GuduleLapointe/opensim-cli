# Environment of the tests: copy this file as tests/.env (git-ignored) and edit it. It is read after the .env of the project.

# Run the container checks on the podman of another machine (a podman system connection)
# CONTAINER_CONNECTION=

# Optional memory limit for deployment containers (no limit by default)
# MEMORY=400m

# Container engine for tests/20-Deploy (default: auto, prefers Podman)
# DEPLOY_ENGINE=podman

# Run quick-install separately for each step (default) or once as one command
# DEPLOY_INSTALL_MODE=single

# Optional alternate deployment platform matrix (default: tests/20-Deploy/platforms.tsv)
# DEPLOY_PLATFORMS_FILE=/path/to/platforms.tsv

# Use a fresh, randomly named set of deployment containers and remove them at cleanup (default: persistent)
# DEPLOY_EPHEMERAL=1

# APT suite used by deployment containers. Leave unset for stable official releases; use tests for test builds.
# DEPLOY_APT_SUITE=tests

# Publish the packages built by the test build to the official tests suite (requires local APT repository clone and signing key).
# APT_REPO_DIR=/path/to/apt-repo
# DEPLOY_PUBLISH_TEST_PACKAGES=1
