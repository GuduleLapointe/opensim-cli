#!/bin/sh
# postinst of opensim-cli: the opensim account, which owns the folders of the system layout, and their default config, left as is
# once created.
set -e

conf=/etc/opensim/opensim.conf
# The folders of the system layout
layout="/etc/opensim /etc/opensim/grids /etc/opensim/presets /etc/opensim/opensim.d /etc/opensim/robust.d
    /var/lib/opensim /var/lib/opensim/data /var/log/opensim /var/cache/opensim"

case "$1" in
    configure)
        # Instances run as opensim; its shell lets admins work as it (sudo -iu opensim)
        if ! getent passwd opensim >/dev/null; then
            adduser --system --group --home /var/lib/opensim --shell /bin/bash opensim
        fi

        for dir in $layout; do
            mkdir -p "$dir"
        done

        # The helpers read the ini files of each grid through the web server, and any of them may hold a password: readable by
        # its group only, when the machine has one
        if getent group www-data >/dev/null 2>&1; then
            adduser --quiet opensim www-data || true
        fi

        # They belong to opensim, also after upgrades; an admin's override stays
        for dir in $layout; do
            dpkg-statoverride --list "$dir" >/dev/null ||
                dpkg-statoverride --update --add opensim opensim 755 "$dir"
        done

        # The commands read the locations here
        if [ ! -e "$conf" ]; then
            cat >"$conf" <<'CONF'
[Defaults]
DirectoryLayout = system
CoreRoot = /usr/share/opensim
EtcRoot = /etc/opensim
VarRoot = /var/lib/opensim
LogsRoot = /var/log/opensim
CacheRoot = /var/cache/opensim
DataRoot = /var/lib/opensim/data
SystemUser = opensim
CONF
            chown opensim:opensim "$conf"
        fi
        ;;
esac

exit 0
