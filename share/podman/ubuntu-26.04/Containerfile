# OpenSimulator in a container: the tools, a release of the core and its
# modules, from the packages of the kit, on an Ubuntu LTS (which has the .NET
# runtime and libgdiplus in its own repositories). No database server: the
# database is another container, or the host's (see packaging/container/README.md).
# Built by packaging/container/build, which gives it the packages (pkgs/).
ARG BASE=docker.io/library/ubuntu:26.04
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive
# A mirror that does not answer once is asked again
RUN echo 'Acquire::Retries "5";' >/etc/apt/apt.conf.d/80retries

# The account of the instances, with a fixed ID: a folder of the host shared
# with the container can be given to it (chown 8002:8002)
RUN groupadd --system  opensim \
 && useradd --system --gid opensim --home-dir /var/lib/opensim --create-home --shell /bin/bash opensim

# The packages depend on "a database server, or PostgreSQL, or SQLite" and on
# "a MySQL client": what is installed first satisfies them, so no server is added
# (the database is another container, or another machine).
# The Magiiic repository gives the packages of the family.


RUN apt-get update \
 && apt-get install -y --no-install-recommends \
 ca-certificates curl gpg openssl

COPY magiiic.list /etc/apt/sources.list.d/magiiic.list

RUN curl -fsSL https://apt.magiiic.com/magiiic-packaging.asc \
 | gpg --dearmor -o /usr/share/keyrings/magiiic-packaging.gpg \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
 libsqlite3-0 mariadb-server dotnet-runtime-10.0 \
 php-cli php-curl php-intl php-mbstring php-mysql php-xml \
 && apt-get install -y --no-install-recommends \
 opensim-cli \
 && rm -rf /pkgs /var/lib/apt/lists/*

USER opensim
WORKDIR /var/lib/opensim

# Config, data and logs belong to the volumes; the cache can be a tmpfs
VOLUME ["/etc/opensim", "/var/lib/opensim", "/var/log/opensim"]

STOPSIGNAL SIGTERM
# ENTRYPOINT ["/usr/local/bin/opensim-container"]
