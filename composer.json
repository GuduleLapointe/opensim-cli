{
    "name": "magicoli/opensim-cli",
    "description": "The command line to set up and manage OpenSimulator, in bash.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Olivier van Helden",
            "homepage": "https://magiiic.com"
        }
    ],
    "require": {
        "magicoli/container-tools": "^0.1.0@alpha",
        "magicoli/opensim-engine": "^3.0@beta",
        "magicoli/bash-tools": "^1.0"
    },
    "require-dev": {
        "magicoli/build-tools": "^0.1.11"
    },
    "repositories": [],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "bin": [
        "bin/opensim"
    ],
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "./lib/bashunit/bashunit"
        ]
    }
}
