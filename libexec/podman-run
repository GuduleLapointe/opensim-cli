#!/usr/bin/env bash

set -e

say() {
	[ -n "$*" ] && echo "$PGM: $*" >&2 || return
}
log() {
	DEBUG=${DEBUG:-no}
	[ ! "${DEBUG:-}" = "yes" ] && return
	say "$*"
}

PGM=$(basename "$0")
TMP=$(mktemp) || exit $?
trap "rm -rf $TMP $TMP.*" EXIT

BASEDIR=$(cd $(dirname $0)/.. && pwd)
log BASEDIR $BASEDIR
SHAREDIR=$(cd $BASEDIR/share 2>/dev/null ||
	cd /usr/share/opensim-cli/share 2>/dev/null && pwd) ||
	exit 2
log SHAREDIR $SHAREDIR
log Images $SHAREDIR/podman/images

if ! cut -d"#" -f 1 $SHAREDIR/podman/images | grep "." >$TMP.images; then
	log empty images list $SHAREDIR/podman/images
	exit 1
fi

if [ -z "$1" ]; then
	echo "usage: $PGM <container-id>"
	echo
	cat $TMP.images | sed "s/^/  /"
	exit
fi
image_id=localhost/opensim-$1
log image_id $image_id
shift

args=(
	-d
	-i
)
if [ -n "${1:-}" ]; then
	log setting name to $1
	args+=("--name $1")
	args+=("--hostname $1")

	say getting ports for $*
	args+=($(opensim ports --publish $*))
else
	args+=("-P")
fi

log setting mount points
mount_points=(
	/etc/opensim
	/var/lib/opensim
	/var/log/opensim
)
for mount_point in ${mount_points[@]}; do
	echo mount_point $mount_point
	src=$(realpath $mount_point)
	args+=("--volume ${src}:${mount_point}")
	# args+=("--mount=type=bind,source=$src,destination=$mount_point")
	# args+=("--mount type=bind,src=$src,dst=$mount_point,bind-propagation=shared")
done

remote=${CONTAINER_CONNECTION:+ssh ${CONTAINER_CONNECTION}}
container_uid=134
container_gid=143
host_uid=${CONTAINER_USER:-$(id -u $container_uid 2>/dev/null || id -u)}
host_gid=${CONTAINER_GROUP:-$(id -g $container_uid 2>/dev/null || id -u)}
if [ -n "$CONTAINER_CONNECTION" ]; then
	log get host user on $CONTAINER_CONNECTION
	ssh $CONTAINER_CONNECTION "echo host_uid=\$(id -u $container_uid 2>/dev/null || id -u);
    echo host_gid=\$(id -u $container_uid 2>/dev/null || id -u)" >$TMP.remote_user
	. $TMP.remote_user
fi
log host user $host_uid:$host_gid

# log check rootless availability
# rootless=$(podman info --format '{{.Host.Security.Rootless}}')

log PODMAN_USERNS ${PODMAN_USERNS:-(not set)}

if [[ "$rootless" == "true" ]]; then
	# 	say "Rootless true, map user namespace"
	# 	# if [[ "$host_uid" != 0:0 ]]; then
	# 	# 	say "rootless Podman cannot map OpenSim volumes owned by $host_uid; run Podman as their owner or use a rootful connection"
	# 	# 	exit 1
	# 	# fi
	args+=(--userns=keep-id:uid=$container_uid,gid=$container_gid)
else
	args+=(--userns=host)
fi
# 	args+=(--userns=keep-id:uid=$host_uid,gid=$host_gid)
# elif [[ "$container_uid" != "$host_uid" ]]; then
# 	say "Rootless false, set mapping $container_uid to $host_uid"
# 	args+=(
# 		--uidmap 0:0:65536
# 		--gidmap 0:0:65536
# 		--uidmap +$container_uid:$host_uid:1
# 		--uidmap +$host_uid:65536:1
# 		--gidmap +$container_gid:$host_gid:1
# 		--gidmap +$host_gid:65536:1
# 		# --uidmap +$host_uid:$container_uid:1
# 		# --uidmap +$container_uid:65536:1
# 		# --gidmap +$host_gid:$container_gid:1
# 		# --gidmap +$container_gid:65536:1
# 	)
# fi

env | egrep "^(APT_SOURCE|OPENSIM_DB|DEFAULT_)" >$TMP.env
echo "CONTAINER_HOST=$(hostname -f)" >>$TMP.env
echo "CONTAINER_NAME=$(hostname -s)" >>$TMP.env
args+=("--env-file $TMP.env")

echo podman run ${args[@]} $image_id

if [ "$YES" = yes ]; then
	start=y
else
	read -p "start container (Y/n)? " start
	start=${start:-y}
fi
if [ "$start" = "y" ]; then
	container_id=$(podman run ${args[@]} $image_id)
	podman container inspect $container_id | grep '"Name":' | head -1 | sed 's/"//g; s/,$//; s/^ *//'
	echo "Id: $container_id"
fi
