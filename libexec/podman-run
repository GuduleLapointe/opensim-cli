#!/usr/bin/env bash

set -e

say() {
	[ -n "$*" ] && echo "$PGM: $*" >&2 || return
}
log() {
	DEBUG=${DEBUG:-no}
	[ ! "${DEBUG:-}" = "yes" ] && return
	say "$*"
}

PGM=$(basename "$0")
TMP=$(mktemp) || exit $?
trap "rm -rf $TMP $TMP.*" EXIT

BASEDIR=$(cd $(dirname $0)/.. && pwd)
log BASEDIR $BASEDIR
SHAREDIR=$(cd $BASEDIR/share 2>/dev/null ||
	cd /usr/share/opensim-cli/share 2>/dev/null && pwd) ||
	exit 2
log SHAREDIR $SHAREDIR
log Images $SHAREDIR/podman/images

if ! cut -d"#" -f 1 $SHAREDIR/podman/images | grep "." >$TMP.images; then
	log empty images list $SHAREDIR/podman/images
	exit 1
fi

if [ -z "$1" ]; then
	echo "usage: $PGM <container-id>"
	echo
	cat $TMP.images | sed "s/^/  /"
	exit
fi
image_id=opensimhelpers.dev/charm/opensim-$1
shift
args=(
	-d
	-i
)
if [ -n "${1:-}" ]; then
	args+=("--name $1")
	args+=("--hostname $1")

	say getting ports for $*
	args+=($(opensim ports --publish $*))
else
	args+=("-P")
fi
mount_points=(
	/etc/opensim
	/var/lib/opensim
)
for mount_point in ${mount_points[@]}; do
	echo mount_point $mount_point
	args+=("--volume $mount_point:$mount_point")
	# args+=("--mount=type=bind,source=$mount_point,destination=$mount_point")
done

env | egrep "^(APT_SOURCE|OPENSIM_DB|DEFAULT_)" >$TMP.env
echo "CONTAINER_HOST=$(hostname -f)" >>$TMP.env
echo "CONTAINER_NAME=$(hostname -s)" >>$TMP.env
args+=("--env-file $TMP.env")

echo podman run ${args[@]} $image_id

read -p "start container (Y/n)? " start
start=${start:-y}
if [ "$start" = "y" ]; then
	container_id=$(podman run ${args[@]} $image_id)
	podman container inspect $container_id | grep '"Name":' | head -1 | sed 's/"//g; s/,$//; s/^ *//'
	echo "Id: $container_id"
fi
