#!/usr/bin/env bash
# opensim setup: what to set up, then all the questions on one screen, checked by the engine, then the setup they stand for.

USAGE="opensim setup [-hqv]"
HELP="Asks what to set up, then a form with the few questions it needs, and checks the answers with the engine. The engine proposes everything else."

source "$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../src/lib/common"
source "$CLI_ROOT/src/lib/ui"

type= name= login_uri= hypergrid=yes avatar= password= password2= email=
reply=
declare -A LABEL=() SECRET=([password]=1 [password2]=1)

# What the questions are called, for the type chosen
set_labels() {
    LABEL=(
        [name]="Grid name"
        [login_uri]="Login URI"
        [hypergrid]="Hypergrid"
        [avatar]="Avatar name"
        [password]="Password"
        [password2]="Password again"
        [email]="Email"
    )
    [[ $type == standalone ]] && LABEL[name]="Region name"
}

# Ask the engine about the answers so far: its reply is $reply
check() {
    local body
    body=$(jq -n \
        --arg type "$type" --arg name "$name" --arg login_uri "$login_uri" --arg hypergrid "$hypergrid" \
        --arg avatar "$avatar" --arg password "$password" --arg email "$email" \
        '{data: {type: "setups", attributes: ({type: $type, name: $name, login_uri: $login_uri, hypergrid: $hypergrid,
            avatar: $avatar, password: $password, email: $email} | with_entries(select(.value != "")))}}')
    reply=$(engine POST /setups/quick --data=- <<<"$body" 2>&1)
    jq -e '.data.attributes.setup' >/dev/null 2>&1 <<<"$reply" || die "The engine does not answer as it should: $reply"
}

# One thing of the reply
field() {
    jq -r "$1" <<<"$reply"
}

# What the engine found wrong, one line each, by the name of the question
problems() {
    local question
    for question in $(field '.data.attributes.problems | keys[]'); do
        printf '! %s: %s\n' "${LABEL[$question]:-$question}" "$(field ".data.attributes.problems.$question")"
    done
}

# Every value the setup defines, as the engine lists them: * Label: value, a blank line between the sections
summary() {
    local section label value previous=
    while IFS=$'\t' read -r section label value; do
        [[ -n "$previous" && "$section" != "$previous" ]] && echo
        previous=$section
        printf '* %s: %s\n' "$label" "$value"
    done < <(field '.data.attributes.rows[] | [.section, .label, .value] | @tsv')
}

# What can be set up: the grid and the standalone, and the presets, listed to preview the menu (the engine will list the ones there are)
UNAVAILABLE=" speculoos osgrid "

# The steps: the type, the options (check boxes), the form. Back goes one step back; Back from the type and Quit end it.
step=type
while :; do
    status=0
    case $step in
        type)
            ui_menu type "Type" grid "Grid" standalone "Standalone" speculoos "Speculoos (soon)" osgrid "OSGrid (soon)" || status=$?
            ((status == 0)) || die "Cancelled"
            if [[ "$UNAVAILABLE" == *" $type "* ]]; then
                ui_message "Not available yet: only Grid and Standalone for now."
                continue
            fi
            set_labels
            check
            name=$(field .data.attributes.setup.grid.name)
            login_uri="$(field .data.attributes.setup.grid.hostname):$(field .data.attributes.setup.grid.public_port)"
            notice=
            tries=0
            step=options
            ;;
        options)
            ui_checks "Setup: ${type^}" "" hypergrid || status=$?
            case $status in 0) step=form ;; 1) step=type ;; *) die "Cancelled" ;; esac
            ;;
        form)
            ui_form "Setup: ${type^}" "$notice" name login_uri avatar password password2 email || status=$?
            case $status in 1) step=options; continue ;; 2) die "Cancelled" ;; esac
            if [[ "$password" != "$password2" ]]; then
                notice="! Passwords differ"
                password= password2=
                continue
            fi
            check
            [[ "$(field .data.attributes.valid)" == true ]] && break
            ((++tries < 8)) || die "Still not right after $tries tries"
            notice=$(problems)
            ;;
    esac
done

summary
echo
echo "Nothing is created yet."
