#!/usr/bin/env bash
# opensim setup: what to set up, then all the questions on one screen, checked by the engine, then the setup they stand for.

USAGE="opensim setup [-hqv]"
HELP="Asks what to set up, then a form with the few questions it needs, and checks the answers with the engine. The engine proposes everything else."

source "$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../src/lib/common"
source "$CLI_ROOT/src/lib/ui"

type= name= login_uri= hypergrid=yes avatar= password= password2= email=
reply=
declare -A LABEL=() SECRET=([password]=1 [password2]=1)

# What the questions are called, for the type chosen
set_labels() {
    LABEL=(
        [name]="Grid name"
        [login_uri]="Login URI"
        [hypergrid]="Hypergrid"
        [avatar]="Avatar name"
        [password]="Password"
        [password2]="Password again"
        [email]="Email"
    )
    [[ $type == standalone ]] && LABEL[name]="Simulator name"
}

# Ask the engine about the answers so far: its reply is $reply
check() {
    local body
    body=$(jq -n \
        --arg type "$type" --arg name "$name" --arg login_uri "$login_uri" --arg hypergrid "$hypergrid" \
        --arg avatar "$avatar" --arg password "$password" --arg email "$email" \
        '{data: {type: "setups", attributes: ({type: $type, name: $name, login_uri: $login_uri, hypergrid: $hypergrid,
            avatar: $avatar, password: $password, email: $email} | with_entries(select(.value != "")))}}')
    reply=$(engine POST /setups/quick --data=- <<<"$body" 2>&1)
    jq -e '.data.attributes.setup' >/dev/null 2>&1 <<<"$reply" || die "The engine does not answer as it should: $reply"
}

# One thing of the reply
field() {
    jq -r "$1" <<<"$reply"
}

# What the engine found wrong, one line each, by the name of the question
problems() {
    local question
    for question in $(field '.data.attributes.problems | keys[]'); do
        printf '! %s: %s\n' "${LABEL[$question]:-$question}" "$(field ".data.attributes.problems.$question")"
    done
}

summary() {
    local setup=.data.attributes.setup kind simulator
    [[ $type == standalone ]] && kind=Standalone || kind=Grid
    echo
    echo "$kind $(field "$setup.grid.name") ($(field "$setup.grid.nick"))"
    printf '  %-11s %s\n' "Login" "http://$(field "$setup.grid.hostname"):$(field "$setup.grid.public_port")"
    printf '  %-11s %s\n' "Hypergrid" "$(field "if $setup.grid.hypergrid then \"yes\" else \"no\" end")"
    simulator=$(field "$setup.simulators[0].name")
    if [[ $type == standalone ]]; then
        printf '  %-11s %s\n' "Simulator" "$simulator"
        printf '  %-11s %s\n' "Database" "$(field "$setup.simulators[0].database.name") (user $(field "$setup.simulators[0].database.user"))"
    else
        printf '  %-11s %s\n' "Simulator" "$simulator, region $(field "$setup.simulators[0].regions[0].name")"
        printf '  %-11s %s\n' "Databases" "$(field "$setup.grid.database.name") and $(field "$setup.simulators[0].database.name") (user $(field "$setup.grid.database.user"))"
    fi
    printf '  %-11s %s\n' "Owner" "$(field "$setup.owner.name")${email:+ <$email>}"
}

# Back from the form is the menu again, Quit and Back from the menu end it
while :; do
    status=0
    ui_menu type "Type" grid "Grid" standalone "Standalone" || status=$?
    ((status == 0)) || die "Cancelled"
    set_labels

    # The engine proposes what it can
    check
    name=$(field .data.attributes.setup.grid.name)
    login_uri="http://$(field .data.attributes.setup.grid.hostname):$(field .data.attributes.setup.grid.public_port)"

    notice=
    tries=0
    while :; do
        status=0
        ui_form "Setup: ${type^}" "$notice" name login_uri hypergrid avatar password password2 email || status=$?
        ((status == 0)) || break
        if [[ "$password" != "$password2" ]]; then
            notice="! Passwords differ"
            password= password2=
            continue
        fi
        check
        [[ "$(field .data.attributes.valid)" == true ]] && break 2
        ((++tries < 8)) || die "Still not right after $tries tries"
        notice=$(problems)
    done
    ((status == 1)) || die "Cancelled"
done

summary
echo
echo "Nothing is created yet."
