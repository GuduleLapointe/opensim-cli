#!/usr/bin/env bash
# opensim setup: the engine gives the screens (it is the scenario), this draws the one it gets, sends it back filled with the button that
# was pressed, and does the action it answers: another screen, the same one with what is wrong, quit with a message, abort with an error.

USAGE="opensim setup [-hqv]"
HELP="Shows the screens of the engine, which asks what to set up, the few questions it needs and the options, checks the answers and makes the setup."

source "$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../src/lib/common"
source "$CLI_ROOT/src/lib/ui"

state= button=next answers='{}'
errors=$(mktemp) answer=$(mktemp)
trap 'rm -f "$errors" "$answer"' EXIT

# Show what the engine told since the last time. A line starting with "~" is what a wait is on: on a terminal it takes one line
# that the next one replaces, elsewhere it is not shown.
pending=
show_progress() {
	local size line
	size=$(wc -c <"$errors")
	if ((size > shown)); then
		while IFS= read -r line; do
			[[ $line == "opensim: "* ]] || continue
			if [[ ${line#opensim: } == "~"* ]]; then
				[[ -t 2 ]] && printf '\r\033[K%s' "opensim: ${line#opensim: ~}" >&2 && pending=1
			else
				[[ -n $pending ]] && printf '\r\033[K' >&2
				pending=
				printf '%s\n' "$line" >&2
			fi
		done < <(tail -c +"$((shown + 1))" "$errors" | head -c "$((size - shown))")
	fi
	shown=$size
	return 0
}
# The engine gave no screen: what it said (a problem: its status and title), and the errors it wrote that are not progress. Nothing else is done.
fail_engine() {
	local what
	what=$(jq -r 'select(.status) | "HTTP \(.status) \(.title)\(if .detail then ": " + .detail else "" end)"' 2>/dev/null <<<"$1")
	die "The engine does not answer as it should: ${what:-$1}$(grep -v '^opensim: ' "$errors" | sed 's/^/\n  /')"
}

while :; do
	request=$(jq -cn --arg state "$state" --arg button "$button" --argjson answers "$answers" \
		'{data: {type: "steps", attributes: {state: $state, button: $button, answers: $answers}}}')
	# What the engine tells while it works (lines starting with "opensim: ") is shown as it comes. Its answer goes to a file and its
	# error output to another that is read while it runs: the instances it starts keep both open, a pipe would never end
	: >"$errors"
	engine POST /setups/steps --data=- <<<"$request" >"$answer" 2>>"$errors" &
	pid=$!
	shown=0
	while kill -0 "$pid" 2>/dev/null; do
		show_progress
		sleep 0.3
	done
	wait "$pid" 2>/dev/null
	show_progress
	reply=$(<"$answer")
	screen=$(jq -c '.data.attributes' 2>/dev/null <<<"$reply") && [[ "$(jq -r '.action // empty' <<<"$screen")" != "" ]] ||
		fail_engine "$reply"
	case "$(jq -r .action <<<"$screen")" in
	screen) ui_screen "$screen" ;;
	quit)
		jq -r .message <<<"$screen"
		exit 0
		;;
	abort) die "$(jq -r .error <<<"$screen")" ;;
	*) die "The engine asks for an action this command does not know: $(jq -r .action <<<"$screen")" ;;
	esac
done
