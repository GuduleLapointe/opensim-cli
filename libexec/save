#!/usr/bin/env bash
# opensim save: save an inventory or region archive through a running simulator.

USAGE="opensim save iar|oar [GRID [SIM|REGION]] [options] ..."
HELP="Save an inventory (IAR) or region (OAR) archive through a running simulator console."

source "$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../src/lib/common"

run save "$@"
