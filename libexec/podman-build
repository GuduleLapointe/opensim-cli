#!/usr/bin/env bash

set -e

say() {
	[ -n "$*" ] && echo "$PGM: $*" >&2 || return
}
log() {
	DEBUG=${DEBUG:-no}
	[ ! "${DEBUG:-}" = "yes" ] && return
	say "$*"
}

PGM=$(basename "$0")
TMP=$(mktemp) || exit $?
trap "rm -rf $TMP $TMP.*" EXIT

BASEDIR=$(cd $(dirname $0)/.. && pwd)
log BASEDIR $BASEDIR
SHAREDIR=$(cd $BASEDIR/share 2>/dev/null ||
	cd /usr/share/opensim-cli/share 2>/dev/null && pwd) ||
	exit 2
log SHAREDIR $SHAREDIR
log Images $SHAREDIR/podman/images

remote=${CONTAINER_CONNECTION:+ssh ${CONTAINER_CONNECTION}}
log remote $remote

if ! cut -d"#" -f 1 $SHAREDIR/podman/images | grep "." >$TMP.images; then
	log empty images list $SHAREDIR/podman/images
	exit 1
fi

if [ -z "$1" ]; then
	echo "usage: $PGM <image>"
	echo
	cat $TMP.images | sed "s/^/  /"
	exit
fi

OPENSIM_USER=${OPENSIM_USER:-opensim}
OPENSIM_GROUP=${OPENSIM_GROUP:-opensim}
OPENSIM_UID=${OPENSIM_UID:-8002}
OPENSIM_GID=${OPENSIM_GID:-8002}
PODMAN_USER=${PODMAN_USER:-${OPENSIM_USER}}
PODMAN_GROUP=${PODMAN_GROUP:-${OPENSIM_GROUP}}

for key in $*; do
	grep "^$key\b" $TMP.images | while read key image os_id os_version; do
		case $key in
		debian-13 | ubuntu-26.04)
			label=["latest","$os_version"]
			;;
		*)
			label=["$os_version"]
			;;
		esac
		args=(
			--build-arg OPENSIM_USER=${OPENSIM_USER}
			--build-arg OPENSIM_UID=${OPENSIM_UID}
			--build-arg OPENSIM_GROUP=${OPENSIM_GROUP}
			--build-arg OPENSIM_GID=${OPENSIM_GID}
			--network host
			--from $image
			--isolation rootless
			--tag opensim-$key
			--label $label
		)

		say podman build $SHAREDIR/podman/debian ${args[@]}
		podman build $SHAREDIR/podman/debian ${args[@]} || exit $?
	done
done
