#!/usr/bin/env bash
# opensim COMMAND [ARGUMENTS]: set up and manage OpenSimulator (see README.md). The commands are in libexec/.

set -e
here=$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")
libexec=$(cd "$here/../libexec" && pwd)

COMMANDOPTS=setup,status,ports,start,stop,restart,console,screen,install-dotnet
HELP=$(
	cat <<USAGE

  setup           make a grid, a standalone or a simulator that joins a grid
  status          the instances of this machine, running or not
  ports           list instance ports, publishing options or firewall rules
  start           start grids and simulators
  stop            stop grids and simulators
  restart         stop, then start grids and simulators
  console|screen  attach to the console of a running instance
  install-dotnet  install the .NET runtime OpenSimulator needs
USAGE
)
# Command help uses the command's own usage, before dispatch can prepare a setup or elevate privileges.
if [[ -n "${1:-}" && ",$COMMANDOPTS," == *",$1,"* && -x "$libexec/$1" ]]; then
	for argument in "${@:2}"; do
		case "$argument" in -h | --help) exec "$libexec/$1" "${@:2}" ;; esac
	done
fi
export PRESERVE_ENV=PATH,CONTAINER_CONNECTION,DEFAULT_OWNER_NAME,DEFAULT_OWNER_PASSWORD,DOTNET_SYSTEM_NET_DISABLEIPV6,OPENSIM_DB_ADMIN_PASS,OPENSIM_DB_ADMIN_USER,OPENSIM_DB_HOST,OPENSIM_DB_NAME,OPENSIM_DB_PASS,OPENSIM_DB_PORT,OPENSIM_DB_USER,APT_SOURCE_DIR

# $COMMAND and other runtime values are detected by lib/common
. "$here/../src/lib/common" || die could not source opensim common helpers

system_user=$(run system-user 2>/dev/null)
debug_log system_user $system_user

case ${COMMAND:-} in
'')
	help
	end
	;;

setup)
	for argument in "$@"; do
		case "$argument" in
			--prepare | --prepare=*) exec "$libexec/setup" "$@" ;;
		esac
	done
	# A machine without the system layout gets it from the engine (the account, the folders, opensim.conf), which needs root
	if [[ "$(run needs-layout 2>/dev/null)" == "yes" ]]; then
		os=$(uname -s)
		case $os in
		Linux)
			debug_log prepare-layout as root
			as_root php "$here/../src/php/run.php" prepare-layout || exit 1
			;;
		Darwin)
			end $COMMAND not implemented for macOS
			;;
		*)
			end 1 $os operating system not supported
			;;
		esac
	else
		debug_log "prepare-layout not needed"
	fi
	# "$libexec/$COMMAND" "$@"
	as_system_user "$libexec/$COMMAND" "$@"
	# as_root "$libexec/$COMMAND" "$@"
	;;

install-dotnet)
	log install-dotnet as root
	# The runtime is installed for the whole system: as root, whoever calls
	as_root "$libexec/$COMMAND" "$@"
	;;

*)
	if [ -e "$libexec/$COMMAND" ]; then
		as_system_user "$libexec/$COMMAND" "$@"
		# as_root "$libexec/$COMMAND" "$@"
	else
		die "Unrecognized command $COMMAND"
	fi
	;;
esac
