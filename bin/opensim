#!/usr/bin/env bash
# opensim COMMAND [ARGUMENTS]: set up and manage OpenSimulator (see README.md). The commands are in libexec/.

set -e
here=$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")
libexec=$(cd "$here/../libexec" && pwd)

usage() {
	cat >&2 <<USAGE
usage: opensim COMMAND [ARGUMENTS]

  setup           make a grid, a standalone or a simulator that joins a grid
  status          the instances of this machine, running or not
  start           start grids and simulators
  stop            stop grids and simulators
  restart         stop, then start grids and simulators
  console|screen  attach to the console of a running instance
  install-dotnet  install the .NET runtime OpenSimulator needs

Type 'opensim COMMAND --help' for the help of a command.
USAGE
	exit 2
}

command=${1:-}
[[ -n "$command" && -x "$libexec/$command" ]] || usage
shift

# A machine without the system layout gets it from the engine (the account, the folders, opensim.conf), which needs root
if [[ "$command" == setup && "$(set --; source "$here/../src/lib/common" && run needs-layout 2>/dev/null)" == yes ]]; then
	sudo=
	if ((EUID != 0)); then
		sudo="sudo -E env PATH=$PATH"
		sudo true 2>/dev/null || {
			echo "opensim setup needs sudo to make the system layout: run it with sudo, or as a user allowed to" >&2
			exit 1
		}
	fi
	# shellcheck disable=SC2086
	$sudo php "$here/../src/php/run.php" prepare-layout || exit 1
fi

# The runtime is installed for the whole system: as root, whoever calls
if [[ "$command" == install-dotnet ]]; then
	if ((EUID != 0)); then
		self=$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")
		sudo true 2>/dev/null || {
			echo "opensim install-dotnet needs sudo: run it with sudo, or as a user allowed to" >&2
			exit 1
		}
		exec sudo -E env "PATH=$PATH" "$self" "$command" "$@"
	fi
	exec "$libexec/$command" "$@"
fi

# The files of the grids belong to the user the instances run as: the command runs as that user (checked now, before any question)
system_user=$(set --; source "$here/../src/lib/common" && run system-user 2>/dev/null)
if [[ -n "$system_user" && "$(id -un)" != "$system_user" ]]; then
	self=$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")
	if ((EUID == 0)); then
		exec runuser -u "$system_user" -- "$self" "$command" "$@"
	fi
	sudo -u "$system_user" true 2>/dev/null || {
		echo "opensim $command needs sudo to act as $system_user, which owns the files of the grids: run it with sudo, or as a user allowed to run commands as $system_user" >&2
		exit 1
	}
	exec sudo -H -u "$system_user" "$self" "$command" "$@"
fi
exec "$libexec/$command" "$@"
